{
  "name": "ds-lib",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "storybook": "ng run ui-components:storybook",
    "build-storybook": "ng run ui-components:build-storybook",
    "icons:generate": "node scripts/generate-lib-icons.mjs",
    "generate:entry-point": "node scripts/generate-entry-point.mjs",
    "generate:entry-points-index": "node scripts/generate-entry-points-index.mjs",
    "prestorybook": "npm run generate:entry-points-index",
    "prebuild": "npm run generate:entry-points-index",
    "build:ui-components": "ng build ui-components",
    "postbuild:ui-components": "npm run generate:entry-points-index",
    "flags:generate": "node scripts/generate-lib-flags.mjs",
    "deploy-storybook": "npm run build-storybook && node -e \"require('fs').writeFileSync('storybook-static/.nojekyll', '')\" && npx gh-pages -d storybook-static -t -f"
  },
  "private": true,
  "packageManager": "npm@11.2.0",
  "dependencies": {
    "@angular/cdk": "^22.0.5",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.6",
    "@angular/material-date-fns-adapter": "^22.0.6",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.3",
    "@angular-devkit/architect": "^0.2200.0",
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular-devkit/core": "^22.0.0",
    "@angular/animations": "^22.0.0",
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@chromatic-com/storybook": "^5.2.1",
    "@compodoc/compodoc": "^2.0.0",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-vitest": "^10.5.3",
    "@storybook/angular-vite": "^10.5.3",
    "@types/node": "^20",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "flag-icons": "^7.5.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.0.0",
    "playwright": "^1.61.1",
    "prettier": "^3.8.1",
    "storybook": "^10.5.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.0.8"
  }
}